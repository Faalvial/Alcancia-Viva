# ==============================================================================
# ALCANCÍA VIVA - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Proveedor de LLM seleccionado: 'mock' | 'openai' | 'anthropic' | 'ollama'
# Para demostración académica sin claves API, usar 'mock'.
VITE_LLM_PROVIDER=mock

# Clave API de OpenAI (requerida solo si VITE_LLM_PROVIDER=openai)
VITE_OPENAI_API_KEY=

# Clave API de Anthropic Claude (requerida solo si VITE_LLM_PROVIDER=anthropic)
VITE_ANTHROPIC_API_KEY=

# URL del servidor local de Ollama (requerida solo si VITE_LLM_PROVIDER=ollama)
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_MODEL=llama3:8b

# Supabase (requerido para colaboración multiusuario en tiempo real)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Configuración de voz (Web Speech API)
VITE_SPEECH_LANG=es-PE
